digraph F {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Diagrama de flujo del proceso de extracción ETL", pad=0.4, nodesep=0.5, ranksep=0.5, bgcolor="white"];
  node  [fontname="DejaVu Sans", fontsize=12, shape=box, style="rounded,filled", fillcolor="#DBEAFE", color="#2563EB", penwidth=1.3, margin="0.2,0.1"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#374151"];

  ini  [label="Inicio del servicio", shape=ellipse, fillcolor="#BBF7D0", color="#16A34A"];
  cfg  [label="Cargar y validar configuración\n(appsettings + User Secrets/env)"];
  okc  [label="¿Configuración válida?", shape=diamond, fillcolor="#FEF3C7", color="#D97706"];
  stop [label="Falla al arrancar\n(mensaje claro)", shape=ellipse, fillcolor="#FECACA", color="#DC2626"];
  cyc  [label="Nuevo ciclo ETL\n(BatchId, scope de DI, Stopwatch)"];
  par  [label="Lanzar extractores habilitados en paralelo\n(Task.WhenAll + SemaphoreSlim)", fillcolor="#BBF7D0", color="#16A34A"];
  ext  [label="Extraer en streaming\nCSV · BD · API"];
  val  [label="Normalizar y validar cada registro\n(texto no vacío, rating 1-5)"];
  inv  [label="Descartar y contar inválidos\n(log Debug/Warning)", fillcolor="#FEF9C3", color="#CA8A04"];
  wrt  [label="Escribir en staging\n(JSON temporal o SqlBulkCopy en transacción)"];
  ok   [label="¿Éxito?", shape=diamond, fillcolor="#FEF3C7", color="#D97706"];
  ret  [label="¿Quedan reintentos?", shape=diamond, fillcolor="#FEF3C7", color="#D97706"];
  bo   [label="Backoff exponencial\n(log Warning)", fillcolor="#FEF9C3", color="#CA8A04"];
  fail [label="Registrar error definitivo\n(la fuente se marca FALLIDA;\nlas demás continúan)", fillcolor="#FECACA", color="#DC2626"];
  sum  [label="Consolidar resultados y registrar resumen\n(leídos / válidos / inválidos / escritos / ms)"];
  once [label="¿RunOnce?", shape=diamond, fillcolor="#FEF3C7", color="#D97706"];
  wait [label="Esperar IntervalMinutes"];
  fin  [label="Detener servicio", shape=ellipse, fillcolor="#E5E7EB", color="#6B7280"];

  ini -> cfg -> okc;
  okc -> stop [label="No"];
  okc -> cyc  [label="Sí"];
  cyc -> par -> ext -> val;
  val -> inv [label="inválido", style=dashed];
  val -> wrt [label="válido"];
  wrt -> ok;
  ok -> sum [label="Sí"];
  ok -> ret [label="No"];
  ret -> bo [label="Sí"];
  bo -> ext [label="reintentar", constraint=false];
  ret -> fail [label="No"];
  fail -> sum;
  sum -> once;
  once -> fin  [label="Sí"];
  once -> wait [label="No"];
  wait -> cyc [constraint=false];
  {rank=same; val; inv}
}
